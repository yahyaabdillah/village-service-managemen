# Port bridge ini listen (harus sama dengan yang dibuka di firewall VPS)
WA_BRIDGE_PORT=3555

# Host bind, biarkan 0.0.0.0 supaya bisa diakses dari luar VPS (misal oleh Vercel)
WA_BRIDGE_HOST=0.0.0.0

# Wajib diisi dan HARUS SAMA dengan WHATSAPP_BRIDGE_TOKEN di .env Laravel (Vercel).
# Tanpa ini, siapa pun yang tahu IP:port VPS bisa kirim pesan WA lewat API ini.
WHATSAPP_BRIDGE_TOKEN=

# Lokasi penyimpanan session Baileys, QR code, dan status koneksi
WA_BRIDGE_STORAGE=storage/whatsapp

# Level logging pino: silent | fatal | error | warn | info | debug | trace
WA_BRIDGE_LOG_LEVEL=silent
