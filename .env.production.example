APP_NAME="Sistem Layanan Desa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://desa.example.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_SECURITY_LEVEL=info
LOG_SECURITY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=village_service
DB_USERNAME=village_service
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=private
PRIVATE_STORAGE_DRIVER=s3
OBJECT_STORAGE_ACCESS_KEY_ID=change-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me
OBJECT_STORAGE_REGION=your-project-region
OBJECT_STORAGE_BUCKET=village-service-private
OBJECT_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_URL=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@desa.example.id
MAIL_FROM_NAME="${APP_NAME}"

UPLOAD_SCAN_ENABLED=false
UPLOAD_SCANNER_COMMAND="clamscan --no-summary --infected"
UPLOAD_SCANNER_TIMEOUT=30
UPLOAD_BLOCKED_SIGNATURES=EICAR-STANDARD-ANTIVIRUS-TEST-FILE

WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_BRIDGE_URL=http://your-vps-ip:3555
WHATSAPP_BRIDGE_TOKEN=change-me
