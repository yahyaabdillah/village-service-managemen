flowchart TD
    A([Mulai]) --> B[Petugas login]
    B --> C[Buka pengajuan masuk]
    C --> D[Periksa data dan berkas]
    D --> E{Persyaratan lengkap?}
    E -- Tidak --> F[Tolak dan tulis alasan]
    E -- Ya --> G[Verifikasi permohonan]
    G --> H[Proses dokumen]
    H --> I[Generate atau unggah dokumen final]
    I --> J[Terbitkan dan ubah status selesai]
    J --> K[Kirim notifikasi WhatsApp]
    F --> L([Selesai])
    K --> L
    classDef actor fill:#e8f1ff,stroke:#315b8a,color:#111;
    classDef decision fill:#fff4cc,stroke:#9b7b14,color:#111;
    class A,B,C,D,G,H,I,J,K,L actor;
    class E,F decision;
